# Copy to .env.cloud on your server. Never include real values in source archives.
SERVICE_API_TOKEN=replace-with-a-long-random-access-token
LLM_API_KEY=replace-with-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# Set only after configuring your HTTPS reverse proxy, without a trailing path.
# SERVICE_PUBLIC_ORIGIN=https://audio.example.com
# Opens the /submit page for people outside the team. Share this code with them; it must differ from SERVICE_API_TOKEN.
# SUBMIT_ACCESS_CODE=replace-with-a-code-you-give-to-submitters
MAX_UPLOAD_MB=256
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
